{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraeWorkAssistant",
  "version": "0.1.11",
  "identifier": "cn.traework.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TraeWorkAssistant",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/waxilo/TraeWorkAssistant/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQzM5RUZEMDc1NTBBQzkKUldUSkNsVUgvWjdEd0ppL0dZTyt1UC9FZ0JoMTFsaDFOcnczZkxwcDZzNXd3NXlML292SGdJeVMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}