//! Cursor 桌面应用的进程控制：查在不在跑、完全退出、重新拉起。
//!
//! # 为什么接入 Cursor 必须先退出它
//!
//! 它的 AI 设置缓存在内存里，运行中改库会在下次刷盘时被覆盖（见 `cursor.rs` 的说明）。
//! 所以「一键接入」的真实流程是：**退出 Cursor → 写库 → 重新打开**。
//!
//! # 强杀的代价
//!
//! 用的是 `taskkill /F`：不保存就退出，未保存的编辑器内容会丢。这在界面上的
//! 确认框里写明了，用户点头才走到这里。
//!
//! 不带 `/T`：Cursor 是 Chromium 系（Electron），它的一堆子进程都叫 `Cursor.exe`，
//! `/IM` 已经能全部命中；带 `/T` 反而对无窗口子进程无能为力，还可能拖住退出。

use serde::Serialize;
use std::path::PathBuf;
use std::process::Command;

/// 进程名（Electron 主子进程同名）
const EXE: &str = "Cursor.exe";

#[cfg(windows)]
const CREATE_NO_WINDOW: u32 = 0x0800_0000;

/// 重启结果，回给界面显示。
#[derive(Clone, Debug, Default, Serialize)]
pub struct ProcOutcome {
    /// 动手之前它在不在跑
    pub was_running: bool,
    /// 之后有没有成功拉起
    pub launched: bool,
    pub message: String,
}

/// 抑制 Windows 上弹出的黑框（每次 tasklist / taskkill 都会闪一下，很显眼）。
fn quiet(cmd: &mut Command) {
    #[cfg(windows)]
    {
        use std::os::windows::process::CommandExt;
        cmd.creation_flags(CREATE_NO_WINDOW);
    }
    #[cfg(not(windows))]
    let _ = cmd;
}

/// Cursor 现在在不在跑。
pub fn app_running() -> bool {
    #[cfg(windows)]
    {
        let mut cmd = Command::new("tasklist");
        cmd.args(["/FI", &format!("IMAGENAME eq {EXE}"), "/NH"]);
        quiet(&mut cmd);
        match cmd.output() {
            Ok(out) => {
                let text = String::from_utf8_lossy(&out.stdout).to_ascii_lowercase();
                // 没有匹配时 tasklist 会打印「信息: 没有运行的任务...」，不含进程名
                text.contains("cursor.exe")
            }
            Err(_) => false,
        }
    }
    #[cfg(not(windows))]
    {
        // macOS / Linux：bundle 名是 Cursor
        Command::new("pgrep")
            .args(["-x", "Cursor"])
            .output()
            .map(|o| o.status.success())
            .unwrap_or(false)
    }
}

/// 完全退出 Cursor，并等到它真的退干净。
///
/// 返回 `Ok(true)` = 本来就没在跑；`Ok(false)` = 杀掉了。
pub fn quit() -> Result<bool, String> {
    if !app_running() {
        return Ok(true);
    }
    #[cfg(windows)]
    {
        let mut cmd = Command::new("taskkill");
        cmd.args(["/F", "/IM", EXE]);
        quiet(&mut cmd);
        let out = cmd.output().map_err(|e| format!("调用 taskkill 失败：{e}"))?;
        if !out.status.success() {
            let msg = String::from_utf8_lossy(&out.stdout).trim().to_string();
            let err = String::from_utf8_lossy(&out.stderr).trim().to_string();
            return Err(format!(
                "结束 Cursor 失败：{}",
                if err.is_empty() { msg } else { err }
            ));
        }
    }
    #[cfg(not(windows))]
    {
        let _ = Command::new("pkill").args(["-9", "-x", "Cursor"]).status();
    }

    // 等它退干净：写库必须发生在进程真的消失之后，否则它下次刷盘会覆盖我们写的值
    for _ in 0..24 {
        if !app_running() {
            return Ok(false);
        }
        std::thread::sleep(std::time::Duration::from_millis(250));
    }
    Err("Cursor 没能完全退出（可能还有窗口在拦关闭）。请手动退出后重试。".into())
}

/// 找 Cursor 的可执行文件。
///
/// 先按常见安装位置猜（绝大多数用户是 per-user 安装，第一个路径就中）；
/// 都找不到时再问系统要正在运行的进程路径。
pub fn find_exe() -> Option<PathBuf> {
    let mut candidates: Vec<PathBuf> = Vec::new();
    if let Ok(local) = std::env::var("LOCALAPPDATA") {
        let local = PathBuf::from(local);
        candidates.push(local.join("Programs").join("cursor").join(EXE));
        candidates.push(local.join("Programs").join("Cursor").join(EXE));
    }
    if let Ok(pf) = std::env::var("ProgramFiles") {
        candidates.push(PathBuf::from(pf).join("Cursor").join(EXE));
    }
    if let Some(p) = candidates.into_iter().find(|p| p.is_file()) {
        return Some(p);
    }
    running_exe_path()
}

/// 从运行中的进程要可执行文件路径（杀之前调用才有效）。
fn running_exe_path() -> Option<PathBuf> {
    #[cfg(windows)]
    {
        let mut cmd = Command::new("powershell");
        cmd.args([
            "-NoProfile",
            "-NonInteractive",
            "-Command",
            "(Get-Process Cursor -ErrorAction SilentlyContinue | Select-Object -First 1).Path",
        ]);
        quiet(&mut cmd);
        let out = cmd.output().ok()?;
        let path = String::from_utf8_lossy(&out.stdout).trim().to_string();
        if path.is_empty() {
            None
        } else {
            let p = PathBuf::from(path);
            p.is_file().then_some(p)
        }
    }
    #[cfg(not(windows))]
    {
        None
    }
}

/// 拉起 Cursor。已经在跑就不重复拉（避免开第二个窗口）。
pub fn launch() -> Result<(), String> {
    if app_running() {
        return Ok(());
    }
    let exe = find_exe().ok_or(
        "找不到 Cursor 的可执行文件（既不在常见安装目录，也没有正在运行的进程可参考）。请手动打开 Cursor。",
    )?;
    let mut cmd = Command::new(&exe);
    cmd.current_dir(exe.parent().unwrap_or(std::path::Path::new(".")));
    quiet(&mut cmd);
    cmd.spawn()
        .map_err(|e| format!("启动 Cursor 失败（{}）：{e}", exe.display()))?;
    Ok(())
}

/// 只重启，不碰配置（界面上那颗「重启 Cursor」按钮）。
pub fn restart() -> Result<ProcOutcome, String> {
    let was_running = app_running();
    if was_running {
        quit()?;
    }
    launch()?;
    Ok(ProcOutcome {
        was_running,
        launched: true,
        message: if was_running {
            "已重启 Cursor".into()
        } else {
            "Cursor 原本没在运行，已打开".into()
        },
    })
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn outcome_defaults_are_false() {
        let o = ProcOutcome::default();
        assert!(!o.was_running && !o.launched);
    }

    /// 不真的去杀进程，只确认「查状态」这个调用本身不会 panic、能返回布尔。
    #[test]
    fn running_probe_is_total() {
        let running = app_running();
        // 本测试机器上 Cursor 装没装都有可能，只要求它给出一个确定答案
        assert!(running == true || running == false);
    }
}
