{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy2Api",
  "version": "0.2.7",
  "identifier": "com.waxilo.workbuddy2api",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy2API",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "把 WorkBuddy 账号池转成 OpenAI / Responses 兼容 API",
    "longDescription": "WorkBuddy2API：多账号池、自动续签、按积分到期路由；对外提供 OpenAI Chat Completions 与 Responses API，可一键接入 Codex 等客户端。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/waxilo/ai-assistant/releases/download/workbuddy2api-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RjM1MTUxMDgxRjJBREMKUldUY0toOElVVkh6ZVpaOWo2YnU2aWhNQUphbVgyYmdjaDM4RnE2b0crK0VtR3BDMnNCb25CRGYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
