# 自托管运行参数 —— 复制成 .env 由 scripts/db-init.sh 完成（它会顺手生成两个库密码）。
# 手工填的话至少把 DB_* 四项改对，缺任一项服务直接拒绝启动（startup_misconfigured），
# 而不是留到第一个请求才 500。
#
# .env 同时被三处读取：docker compose（含 APP_* 两个端口变量）、src/server.js、
# 以及 scripts/d1-import.sh —— 所以它只放「连哪个库」，测试库另写 .env.test。
#
# 这里没有 JWT/密钥类配置：本服务的凭据**就是池 uuid 本身**，服务端不做鉴权（设计决定，
# 见 README「它不做什么」）。也就不存在「换签名密钥导致所有端掉线」这种事 —— 迁移时
# 客户端一行都不用改。

# ---- 数据库（共享容器 ../../mysql-server；容器内主机名固定是 mysql）----
# 宿主机上直接跑的脚本（npm test、scripts/d1-to-mysql.mjs）解析不到 `mysql` 这个名字，
# 会报 getaddrinfo ENOTFOUND mysql —— 同一个实例在宿主机上是 127.0.0.1:3306，
# d1-import.sh 已按这个改写默认值；测试用的是 scripts/db-init.sh 生成的 .env.test。
DB_HOST=mysql
DB_PORT=3306
DB_NAME=cred_broker
DB_USER=cred_broker
DB_PASSWORD=

# ---- 闸参数（对应原 wrangler.toml 的 [vars]，不填则用 src/cred.js 里的默认值）----
# 两个值都必须是**字符串形态的毫秒数**（Worker 的 vars 就是字符串，适配层保持同形）。
# 客户端会读 /v1/health 核对它们与自身编译期常量是否一致，所以别随手改。
#
# 租约时长。**必须大于客户端「把这一池该签的都签掉 + 提交结果」的最坏耗时**，
# 否则租约提前失效、第二台机器拿到闸，而单链轮换下两边都可能死。
# 闸的作用域是整池，所以要容得下「一轮里连续签若干个账号」，而不只是单个请求的耗时。
# 正常路径上签完就立刻归还，这个值只决定「出意外时闸被占多久」。
LEASE_MS=180000
# 续签失败后的冷静期：凭证真死时，别让几台机器轮流敲同一条已死的链。
FAIL_COOLDOWN_MS=300000

# ---- 可选覆盖：默认值已写死在代码与 compose 里，正常部署不用管 ----
# APP_BIND_ADDR=127.0.0.1   # compose 发布到宿主机的端口绑定地址（只有 compose 读它）
# APP_PORT=8789             # 宿主机端口（8787 归 writing-assistant、8788 归 notify-hub）
# PORT=8787                 # 应用监听端口；改它要同步改 compose 与 healthcheck
# HOST=0.0.0.0              # 应用绑定网卡；容器里保持 0.0.0.0，本机直跑才可换成 127.0.0.1
