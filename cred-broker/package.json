{
  "name": "cred-broker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "账号凭证池：存一整池凭证 + 发一把续签闸，保证同一时刻只有一台机器在续签（续签仍在客户端本机执行）",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/cred.test.js",
    "deploy": "./scripts/deploy.sh",
    "logs": "docker compose logs -f"
  },
  "dependencies": {
    "mysql2": "^3.24.4"
  }
}
