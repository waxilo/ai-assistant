{
  "name": "qoder-assistant",
  "private": true,
  "version": "0.1.12",
  "type": "module",
  "description": "Qoder 助手（Tauri）：多账号签到、定时签到、token 自动续签",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
