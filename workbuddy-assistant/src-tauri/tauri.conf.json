{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddyAssistant",
  "version": "0.1.28",
  "identifier": "com.waxilo.workbuddy-assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy 助手",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "WorkBuddy 多账号签到桌面助手",
    "longDescription": "WorkBuddy 助手：多账号一键/定时签到、登录新账号与导入本机账号、token 自动续签、webhook 通知、GitHub Release 自动更新。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/waxilo/ai-assistant/releases/download/workbuddy-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0RTc3RkRGOEYwODdDRkEKUldUNmZBaVAzMy9udEJ0TUJTUDhRaGpsSlc3akxOei9URDZMWmJtK0FpSEhVaWQrZEJTQkhHU3cK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}